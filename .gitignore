/APP/engines/V3/.venv/
/APP/engines/V3/models/
/APP/engines/V3/tools/
/APP/engines/V2/tools/
/APP/shared/tools/

# Future-proof guards against accidentally committing a new runtime/model path
**/.venv/
**/venv/
**/runtime/
**/models/
!/APP/engines/V5/vendor/LayerD/src/layerd/models/
!/APP/engines/V5/vendor/LayerD/src/layerd/models/**
!/APP/engines/V5/vendor/LayerD/src/layerd/_vendor/simple_lama_inpainting/models/
!/APP/engines/V5/vendor/LayerD/src/layerd/_vendor/simple_lama_inpainting/models/**
**/tools/
*.pth
*.pt
*.onnx
*.safetensors
*.ckpt
*.bin

# Local artwork is private by default. Deliberate README assets may live here.
*.png
*.jpg
*.jpeg
*.webp
*.bmp
*.tif
*.tiff
!/docs/assets/**
!/assets/**

