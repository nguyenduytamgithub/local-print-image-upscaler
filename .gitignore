# User images and generated artifacts
/INPUT/**
!/INPUT/.gitkeep
/OUTPUT/**
!/OUTPUT/.gitkeep
/APP/masters/
/APP/manifests/
/APP/verification/
/APP/work/

# Machine-specific reports and QA artifacts
/HUONG_DAN.txt
/APP/engines/V3/ENV_INFO.txt
